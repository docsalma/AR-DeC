sequenceDiagram
    actor Student
    participant CM as CameraModule
    participant TE as TutoringEngine
    participant AR as ARRenderer
    participant SM as StudentModel
    participant GE as GamificationEngine

    rect rgb(230, 245, 255)
    Note over Student,GE: Learning Session

    Student->>CM: 1. captureFrame()
    CM->>CM: 2. extractText()
    CM->>CM: 3. tokenizeWords()
    CM-->>Student: 4. return detectedWords[]

    Student->>TE: 5. requestExplanation(word, context)
    TE->>SM: 6. getMastery(word)
    SM-->>TE: 7. return P(Lₙ)
    TE->>TE: 8. selectBloomsLevel()
    TE->>AR: 9. displayOverlay(content, position)
    AR-->>Student: 10. render AR annotation

    TE->>GE: 11. onWordScanned(word)
    GE->>GE: 12. addPoints(+5)
    GE-->>Student: 13. showPointsAnimation(+5)

    TE->>SM: 14. updateAfterInteraction(word)
    end

    rect rgb(255, 245, 230)
    Note over Student,GE: Optional: Quiz
    opt Student requests quiz
        Student->>GE: 15. startQuiz(recentWords)
        GE-->>Student: 16. presentQuestion()
        Student->>GE: 17. submitAnswer(questionId, answer)
        GE->>SM: 18. updateMastery(word, correct)
        GE-->>Student: 19. showResult(score, badges)
    end
    end

    rect rgb(245, 235, 250)
    Note over Student,GE: Optional: Help-Seeking
    opt Need help?
        alt A quick question
            Student->>TE: 20. askQuestion(text)
            TE-->>Student: 21. return quickAnswer
        else Need deeper explanation
            Student->>TE: 22. requestDetailedHelp(word)
            TE->>AR: 23. displayScaffoldedContent()
            AR-->>Student: 24. show detailed AR overlay
        else Complex problem
            Note right of Student: Escalate to human teacher
            Student->>TE: 25. escalateToTeacher(context)
            TE-->>Student: 26. teacher notification sent
        end
    end
    end
