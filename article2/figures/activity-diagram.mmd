flowchart TD
    Start(("●")) --> Launch["Launch App"]
    Launch --> Streak["Check Streak"]
    Streak --> Fork1["═══════"]
    Fork1 --> DailyGoal["Update Daily Goal"]
    Fork1 --> Home["Display Home Screen"]
    DailyGoal --> Join1["═══════"]
    Home --> Join1
    Join1 --> OpenCam["Open Camera"]
    OpenCam --> Capture["Capture Text"]
    Capture --> OCR["OCR Processing"]
    OCR --> Extract["Text Extraction"]
    Extract --> Token["Word Tokenization"]
    Token --> WordsFound{"Words\nfound?"}
    WordsFound -->|No| NoText["Display\n'No text detected'"]
    NoText --> Capture
    WordsFound -->|Yes| Lookup["Student Model Lookup\nGet P(Lₙ)"]
    Lookup --> Mastered{"P(Lₙ) <\nthreshold?"}
    Mastered -->|"No (mastered)"| TapWord
    Mastered -->|Yes| Generate["ITS Generate Explanation\nSelect Bloom's Level"]
    Generate --> ARDisplay["AR Display Overlay"]
    ARDisplay --> ScanPts["Award Scan Points\n+5 pts"]
    ARDisplay --> TapWord{"Student\ntaps word?"}
    TapWord -->|No| QuizJoin
    TapWord -->|Yes| Detail["Show Detailed\nExplanation"]
    Detail --> NeedHelp{"Need\nhelp?"}
    NeedHelp -->|"Quick question"| Chatbot["Conversational\nAgent"]
    NeedHelp -->|"Deep explanation"| ITS["Intelligent\nTutor"]
    NeedHelp -->|"Complex problem"| Teacher["Escalate to\nTeacher"]
    NeedHelp -->|No| QuizJoin
    Chatbot --> QuizJoin["═══════"]
    ITS --> QuizJoin
    Teacher --> QuizJoin
    QuizJoin --> TakeQuiz{"Take\nquiz?"}
    TakeQuiz -->|No| ContJoin
    TakeQuiz -->|Yes| GenQuiz["Generate Quiz\nfrom Scanned Words"]
    GenQuiz --> Answer["Answer Questions\n15s timer"]
    Answer --> UpdateMastery["Update Mastery\nvia BKT"]
    UpdateMastery --> QuizPts["Award Quiz Points\nCheck Badges"]
    QuizPts --> ContJoin["═══════"]
    ContJoin --> Continue{"Continue\nsession?"}
    Continue -->|Yes| Capture
    Continue -->|No| Sync["Sync to Backend"]
    Sync --> EndNode(("◉"))

    style Start fill:#000,color:#000
    style EndNode fill:#000,color:#000
