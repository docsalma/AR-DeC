@startuml class-diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam classAttributeFontSize 9
skinparam classBorderColor #333333
skinparam classBackgroundColor #F5F5FF
skinparam arrowColor #555555
skinparam packageBorderColor #888888
skinparam packageBackgroundColor #FAFAFA
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "Segoe UI"
skinparam dpi 150

package "Core Actors" #E3F2FD {
  class Student {
    +currentGroups: List
    +profile: StudentProfile
    --
    +scanText()
    +selectWord()
    +viewExplanation()
    +takeQuiz()
    +viewProgress()
    +askForHelp()
  }

  class Teacher {
    +managedCourses: List
    +createdResources: List
    --
    +defineVocabularyList()
    +assignActivity()
    +viewAnalytics()
    +provideFeedback()
    +manageResources()
  }
}

package "Learning Content" #E8F5E9 {
  class ScannedWord {
    +id: String
    +text: String
    +context: String
    +timestamp: Date
    +boundingBox: Rect
    --
    +getContext()
    +getPosition()
    +getSourceSentence()
  }

  class Explanation {
    +definition: String
    +examples: List
    +relatedConcepts: List
    +bloomsLevel: BloomsLevel
    +source: String
    --
    +getAdaptedContent(level)
    +addExample()
  }

  class DomainModel {
    +vocabularyDB: Map
    +conceptRelationships: Map
    +difficultyLevels: Map
    --
    +lookupWord()
    +getRelatedConcepts()
    +getDifficulty()
  }

  class LearningResource {
    +title: String
    +resourceType: String
    +content: Object
    +difficulty: int
    --
    +getContent()
    +getMetadata()
  }
}

package "Student Modeling" #F3E5F5 {
  class StudentProfile {
    +learningStyle: String
    +competencies: List
    +points: int
    +level: StudentLevel
    +streakDays: int
    +badges: List<Badge>
    --
    +updateCompetencies()
    +trackProgress()
    +getRecommendations()
  }

  class StudentModel {
    +masteryMap: Map<word, P(L_n)>
    +priorKnowledge: float
    +transitionProb: float
    +slipProb: float
    +guessProb: float
    --
    +estimateMastery(word)
    +updateAfterInteraction()
    +getWeakWords()
    +predictPerformance()
  }
}

package "AI & AR" #FFF3E0 {
  class TutoringEngine {
    +domainModel: DomainModel
    +studentModel: StudentModel
    +bloomsMapping: Map
    --
    +getExplanation()
    +selectBloomsLevel()
    +adaptContent()
    +escalateToHuman()
  }

  class ARRenderer {
    +currentOverlays: List
    +renderingMode: RenderMode
    +cameraFeed: Stream
    --
    +displayOverlay()
    +showDefinitionCard()
    +show3DModel()
    +animateTransition()
  }

  class ConversationalAgent {
    +knowledgeSources: List
    +conversationHistory: List
    --
    +processQuery()
    +retrieveInformation()
    +maintainContext()
  }

  class CameraModule {
    +cameraFeed: Stream
    +ocrEngine: OCR
    +detectedRegions: List
    --
    +captureFrame()
    +extractText()
    +getWordPositions()
    +preprocessImage()
  }
}

package "Gamification" #FFEBEE {
  class GamificationEngine {
    +pointsSystem: Config
    +badgeDefinitions: List
    +streakTracker: Tracker
    +comboMultiplier: float
    --
    +onWordScanned()
    +onQuizAnswer()
    +checkBadges()
    +updateStreak()
    +calculateLevel()
  }

  class Badge {
    +id: String
    +name: String
    +description: String
    +icon: String
    +category: BadgeCategory
    +condition: String
    +earnedAt: Date
    --
    +checkCondition()
    +award()
  }

  class Quiz {
    +questions: List<QuizQuestion>
    +timeLimit: int
    +comboMultiplier: float
    +score: int
    --
    +generateFromVocabulary()
    +submitAnswer()
    +calculateScore()
    +getResults()
  }
}

' === Relationships ===
Student "1" --> "1" StudentProfile : has
Student "1" --> "*" CameraModule : uses
Student "1" --> "*" Quiz : takes
Teacher "1" --> "*" LearningResource : manages
Teacher "1" --> "*" DomainModel : defines
CameraModule "1" --> "*" ScannedWord : produces
TutoringEngine "1" --> "*" Explanation : generates
TutoringEngine "1" --> "1" StudentModel : consults
TutoringEngine "1" --> "1" DomainModel : consults
ARRenderer "1" --> "*" Explanation : displays
StudentModel "1" --> "*" ScannedWord : tracks
StudentProfile "1" *-- "*" Badge : contains
GamificationEngine "1" --> "*" Badge : awards
GamificationEngine "1" --> "*" Quiz : manages
Quiz "1" --> "*" ScannedWord : tests

@enduml
